# Copy to .env (never commit .env). All values are secrets unless noted.

# Shared secret: the Next.js server sends "Authorization: Bearer <SERVICE_TOKEN>". Generate a long random string.
SERVICE_TOKEN=

# Supabase → Project Settings → Database → Connection string → "Session pooler" (IPv4). Includes the DB password.
DATABASE_URL=

# console.groq.com → API Keys
GROQ_API_KEY=

# Chat providers. Fill in as many as you like: the pool rotates across them and rests any that hits its
# rate limit, so several small free tiers behave like one larger one. Empty entries are skipped.
GROQ_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OPENROUTER_CHAT_MODEL_2=
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=

# Not secret. Chosen in M3 by the evaluation. Must match EMBEDDING_DIM in config.py.
EMBEDDING_MODEL=BAAI/bge-m3
